# Bearer token(s) accepted on every endpoint (comma-separated, one per client).
# Leave unset to disable auth (server refuses all requests with 401 rather than
# running open).
CONTACTS_SERVER_BEARER_TOKENS=client-token

# Sidecar SQLite: maps a caller's own ids to CNContact's identifier (see
# sidecar.py docstring). No LWW/tombstone bookkeeping here — unlike reminders,
# nothing syncs contacts offline today.
CONTACTS_SERVER_DB_PATH=~/.local/state/apple-contacts-server/meta.db

CONTACTS_SERVER_HOST=127.0.0.1
CONTACTS_SERVER_PORT=4102
